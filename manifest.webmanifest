{
  "name": "ADC Studio",
  "short_name": "ADC Studio",
  "description": "Projetos, fotografias e apresentações profissionais de interiores — offline.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4efe8",
  "theme_color": "#f4efe8",
  "orientation": "any",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ]
}
